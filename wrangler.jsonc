{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skrami",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-01",
  "routes": [{ "pattern": "skrami.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/promo.mp4"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardDO" }]
  },
  "kv_namespaces": [{ "binding": "REGISTRY", "id": "dcf8b325a3f94c5ca3ae3c22c10e057a" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardDO"] }]
}
